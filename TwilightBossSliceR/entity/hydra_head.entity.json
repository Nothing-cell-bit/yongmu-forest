{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "tf_slice:hydra_head",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/hydra4"
      },
      "geometry": {
        "default": "geometry.tf_slice.hydra_head"
      },
      "render_controllers": [
        "controller.render.tf_slice.hydra_hurt"
      ],
      "animations": {
        "main": "animation.tf_slice.hydra_head.state"
      },
      "scripts": {
        "animate": [
          "main"
        ],
        "initialize": [
          "variable.hydra_mouth_render = 0.0;"
        ],
        "pre_animation": [
          "variable.hydra_mouth_render = math.lerp(variable.hydra_mouth_render, query.property('tf_slice:mouth_open'), math.clamp(query.delta_time * 20.0, 0.0, 1.0));"
        ]
      }
    }
  }
}
