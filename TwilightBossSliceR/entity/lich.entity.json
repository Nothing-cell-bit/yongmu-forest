          {
            "checker_compat_lich_shields_01": "math.clamp(((math.mod(math.mod((math.sin(query.life_time * 229.1831) * 14.3239), 360) + 540, 360) - 180) + 180) / 360, 0, 1)"
          },
          {
            "checker_compat_lich_shields_02": "math.clamp(((math.mod(math.mod((query.life_time * 229.1831 + 0 * (360 / math.max(query.variant, 1))), 360) + 540, 360) - 180) + 180) / 360, 0, 1)"
          },
