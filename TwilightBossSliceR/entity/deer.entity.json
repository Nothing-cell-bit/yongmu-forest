{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "tf_slice:deer",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/tf_beautified/entities/deer_v1"
      },
      "geometry": {
        "default": "geometry.tf_slice.deer_art_v1"
      },
      "animations": {
        "walk": "animation.quadruped.walk",
        "look_at_target": "animation.common.look_at_target",
        "art_details": "animation.tf_slice.deer_art.details",
        "art_walk": "animation.tf_slice.deer_art.walk_tail"
      },
      "scripts": {
        "animate": [
          {
            "walk": "query.modified_move_speed"
          },
          "look_at_target",
          "art_details",
          {
            "art_walk": "math.clamp(query.modified_move_speed * 4, 0, 1)"
          }
        ]
      },
      "render_controllers": [
        "controller.render.tf_slice.deer"
      ],
      "spawn_egg": {
        "base_color": "#6A3F24",
        "overlay_color": "#D8B27A"
      }
    }
  }
}
