{
  "format_version": "1.20.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "tf_slice:ur_ghast_trophy_item",
      "item": {
        "tf_slice:ur_ghast_trophy_item": "query.is_item_name_any('slot.armor.head', 'tf_slice:ur_ghast_trophy_item')"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/entity/tf_slice/trophies/ur_ghast",
        "enchanted": "textures/misc/enchanted_actor_glint"
      },
      "geometry": {
        "default": "geometry.tf_slice.ur_ghast_trophy_wearable"
      },
      "scripts": {
        "parent_setup": "variable.helmet_layer_visible = (query.is_item_name_any('slot.armor.head', 'tf_slice:ur_ghast_trophy_item')) ? 0.0 : variable.helmet_layer_visible;",
        "animate": [
          "idle",
          {
            "hide_first_person": "context.is_first_person == 1.0"
          }
        ]
      },
      "animations": {
        "hide_first_person": "animation.tf_slice.trophy_wearable.hide_first_person",
        "idle": "animation.tf_slice.trophy_wearable.ur_ghast_idle"
      },
      "render_controllers": [
        {
          "controller.render.armor": "query.is_item_name_any('slot.armor.head', 'tf_slice:ur_ghast_trophy_item')"
        }
      ]
    }
  }
}
