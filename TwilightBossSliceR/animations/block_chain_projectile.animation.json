            "query.mod.tf_chain_head_z * 0.05 + query.mod.tf_chain_hand_z * 0.95"
          ],
          "scale": "query.mod.tf_chain_ready"
        },
        "chain_1": {
          "position": [
            "query.mod.tf_chain_head_x * 0.25 + query.mod.tf_chain_hand_x * 0.75",
            "query.mod.tf_chain_head_y * 0.25 + query.mod.tf_chain_hand_y * 0.75",
            "query.mod.tf_chain_head_z * 0.25 + query.mod.tf_chain_hand_z * 0.75"
          ],
          "scale": "query.mod.tf_chain_ready"
        },
        "chain_2": {
          "position": [
            "query.mod.tf_chain_head_x * 0.45 + query.mod.tf_chain_hand_x * 0.55",
