        },
        "chain_4": {
          "position": [
            "query.mod.tf_chain_head_x * 0.85 + query.mod.tf_chain_hand_x * 0.15",
            "query.mod.tf_chain_head_y * 0.85 + query.mod.tf_chain_hand_y * 0.15",
            "query.mod.tf_chain_head_z * 0.85 + query.mod.tf_chain_hand_z * 0.15"
