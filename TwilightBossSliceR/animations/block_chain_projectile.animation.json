{
  "format_version": "1.10.0",
  "animations": {
    "animation.tf_slice.block_chain_projectile.chain": {
      "loop": true,
      "bones": {
        "chain_0": {
          "scale": 0
        },
        "chain_1": {
          "scale": 0
        },
        "chain_2": {
          "scale": 0
        },
        "chain_3": {
          "scale": 0
        },
        "chain_4": {
          "scale": 0
        }
      }
    },
    "animation.tf_slice.block_chain_link.chain": {
