        "components": {
          "minecraft:geometry": "geometry.tf_slice.firefly",
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              4,
              0,
              -5
            ],
            "size": [
              4,
              16,
              10
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'east'",
        "components": {
          "minecraft:geometry": "geometry.tf_slice.firefly",
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -8,
              0,
              -5
            ],
            "size": [
              4,
              16,
              10
            ]
          }
        }
