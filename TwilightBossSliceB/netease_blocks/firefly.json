          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -5,
              0,
              4
            ],
            "size": [
              10,
              16,
              4
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'south'",
        "components": {
          "minecraft:geometry": "geometry.tf_slice.firefly",
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          },
          "minecraft:selection_box": {
            "origin": [
              -5,
              0,
              -8
            ],
            "size": [
              10,
              16,
              4
            ]
          }
        }
      },
      {
