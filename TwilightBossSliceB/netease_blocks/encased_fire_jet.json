{
  "format_version": "1.20.60",
  "minecraft:block": {
    "description": {
      "identifier": "tf_slice:encased_fire_jet",
      "register_to_creative_menu": false,
      "states": {
        "tf_slice:jet_state": [
          "idle",
          "popping",
          "flame",
          "timeout"
        ]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6.0
      },
      "minecraft:geometry": "geometry.tf_slice.courtyard_cube",
      "minecraft:material_instances": {
        "side": {
          "texture": "tf_slice:encased_fire_jet_side_off",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "top": {
          "texture": "tf_slice:encased_fire_jet_top_off",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "bottom": {
          "texture": "tf_slice:encased_towerwood",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "*": {
          "texture": "tf_slice:encased_fire_jet_side_off",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        }
      },
      "netease:aabb": {
        "collision": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        },
        "clip": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        }
      },
      "netease:render_layer": {
        "value": "opaque"
      },
      "netease:solid": {
        "value": true
      },
      "netease:pathable": {
        "value": false
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('tf_slice:jet_state') == 'popping' || query.block_state('tf_slice:jet_state') == 'flame'",
        "components": {
          "minecraft:material_instances": {
            "side": {
              "texture": "tf_slice:encased_fire_jet_side_on",
              "render_method": "opaque",
              "ambient_occlusion": true,
              "face_dimming": true
            },
            "top": {
              "texture": "tf_slice:encased_fire_jet_top_on",
              "render_method": "opaque",
              "ambient_occlusion": true,
              "face_dimming": true
            },
            "bottom": {
              "texture": "tf_slice:encased_towerwood",
              "render_method": "opaque",
              "ambient_occlusion": true,
              "face_dimming": true
            },
            "*": {
              "texture": "tf_slice:encased_fire_jet_side_on",
              "render_method": "opaque",
              "ambient_occlusion": true,
              "face_dimming": true
            }
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:jet_state') == 'flame'",
        "components": {
          "minecraft:light_emission": 15
        }
      }
    ]
  }
}
