{
  "format_version": "1.20.60",
  "minecraft:block": {
    "description": {
      "identifier": "tf_slice:nagastone",
      "register_to_creative_menu": true,
      "states": {
        "tf_slice:variant": [
          "axis_x",
          "axis_y",
          "axis_z",
          "east_down",
          "east_up",
          "north_down",
          "north_up",
          "solid",
          "south_down",
          "south_up",
          "west_down",
          "west_up"
        ]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6.0
      },
      "minecraft:geometry": "geometry.tf_slice.courtyard_segment",
      "minecraft:material_instances": {
        "*": {
          "texture": "tf_slice:nagastone_long_side",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "side": {
          "texture": "tf_slice:nagastone_long_side",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "top": {
          "texture": "tf_slice:nagastone_turn_top",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "bottom": {
          "texture": "tf_slice:nagastone_bottom_long",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        }
      },
      "netease:aabb": {
        "collision": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        },
        "clip": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        }
      },
      "netease:render_layer": {
        "value": "opaque"
      },
      "netease:solid": {
        "value": true
      },
      "netease:pathable": {
        "value": false
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('tf_slice:variant') == 'axis_x'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              90
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'axis_z'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'east_down'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'east_up'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'south_down'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'south_up'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'west_down'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:variant') == 'west_up'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      }
    ]
  }
}
