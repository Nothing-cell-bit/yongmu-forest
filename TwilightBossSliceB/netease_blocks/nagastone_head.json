{
  "format_version": "1.20.60",
  "minecraft:block": {
    "description": {
      "identifier": "tf_slice:nagastone_head",
      "register_to_creative_menu": true,
      "states": {
        "tf_slice:facing": [
          "north",
          "east",
          "south",
          "west"
        ]
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 6.0
      },
      "minecraft:geometry": "geometry.tf_slice.courtyard_oriented_cube",
      "minecraft:material_instances": {
        "*": {
          "texture": "tf_slice:nagastone_cross_section",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "front": {
          "texture": "tf_slice:nagastone_face_front",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "back": {
          "texture": "tf_slice:nagastone_cross_section",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "left": {
          "texture": "tf_slice:nagastone_face_left",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "right": {
          "texture": "tf_slice:nagastone_face_right",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        },
        "end": {
          "texture": "tf_slice:nagastone_top_tip",
          "render_method": "opaque",
          "ambient_occlusion": true,
          "face_dimming": true
        }
      },
      "netease:aabb": {
        "collision": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        },
        "clip": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        }
      },
      "netease:render_layer": {
        "value": "opaque"
      },
      "netease:solid": {
        "value": true
      },
      "netease:pathable": {
        "value": false
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('tf_slice:facing') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              -90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'up'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              -90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:facing') == 'down'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      }
    ]
  }
}
