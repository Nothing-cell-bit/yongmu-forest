      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.0
      },
      "minecraft:geometry": "geometry.tf_slice.huge_lily_pad_quadrant",
      "minecraft:material_instances": {
        "*": {
          "texture": "tf_slice:huge_lily_pad_ne",
          "render_method": "alpha_test",
          "ambient_occlusion": false,
          "face_dimming": false
        }
      },
      "netease:render_layer": {
        "value": "optionalAlpha"
      },
      "netease:solid": {
        "value": false
      },
      "netease:pathable": {
        "value": true
      },
      "netease:aabb": {
        "collision": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            0.0625,
            1.0
          ]
        },
        "clip": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            0.0625,
            1.0
          ]
        }
      }
    },
    "permutations": [
