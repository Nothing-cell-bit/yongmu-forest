{
  "format_version": "1.20.60",
  "minecraft:block": {
    "description": {
      "identifier": "tf_slice:reappearing_block",
      "register_to_creative_menu": false,
      "states": {
        "tf_slice:active": [
          false,
          true
        ],
        "tf_slice:vanished": [
          false,
          true
        ]
      }
    },
    "components": {
      "minecraft:geometry": "geometry.tf_slice.courtyard_cube",
      "minecraft:material_instances": {
        "*": {
          "texture": "tf_slice:reappearing_block",
          "render_method": "opaque"
        }
      },
      "netease:aabb": {
        "collision": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        },
        "clip": {
          "min": [
            0.0,
            0.0,
            0.0
          ],
          "max": [
            1.0,
            1.0,
            1.0
          ]
        }
      },
      "netease:render_layer": {
        "value": "opaque"
      },
      "netease:solid": {
        "value": true
      },
      "netease:pathable": {
        "value": false
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 4.0
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 10.0
      },
      "netease:block_entity": {
        "tick": true,
        "movable": false
      },
      "netease:neighborchanged_sendto_script": {
        "value": true
      }
    },
    "permutations": [
      {
        "condition": "query.block_state('tf_slice:active') == true && query.block_state('tf_slice:vanished') == false",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "tf_slice:reappearing_block_active",
              "render_method": "opaque"
            }
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:vanished') == true && query.block_state('tf_slice:active') == false",
        "components": {
          "minecraft:geometry": "geometry.tf_slice.reappearing_trace",
          "minecraft:material_instances": {
            "*": {
              "texture": "tf_slice:reappearing_trace_off",
              "render_method": "alpha_test",
              "ambient_occlusion": false,
              "face_dimming": false
            }
          },
          "minecraft:collision_box": false,
          "minecraft:selection_box": {
            "origin": [
              -2,
              6,
              -2
            ],
            "size": [
              4,
              4,
              4
            ]
          },
          "minecraft:light_dampening": 0,
          "netease:aabb": {
            "collision": {
              "min": [
                0.0,
                0.0,
                0.0
              ],
              "max": [
                0.0,
                0.0,
                0.0
              ]
            },
            "clip": {
              "min": [
                0.375,
                0.375,
                0.375
              ],
              "max": [
                0.625,
                0.625,
                0.625
              ]
            }
          },
          "netease:render_layer": {
            "value": "optionalAlpha"
          },
          "netease:no_crop_face_block": {},
          "netease:solid": {
            "value": false
          },
          "netease:pathable": {
            "value": true
          }
        }
      },
      {
        "condition": "query.block_state('tf_slice:vanished') == true && query.block_state('tf_slice:active') == true",
        "components": {
          "minecraft:geometry": "geometry.tf_slice.reappearing_trace",
          "minecraft:material_instances": {
            "*": {
              "texture": "tf_slice:reappearing_trace_on",
              "render_method": "alpha_test",
              "ambient_occlusion": false,
              "face_dimming": false
            }
          },
          "minecraft:collision_box": false,
          "minecraft:selection_box": {
            "origin": [
              -2,
              6,
              -2
            ],
            "size": [
              4,
              4,
              4
            ]
          },
          "minecraft:light_dampening": 0,
          "netease:aabb": {
            "collision": {
              "min": [
                0.0,
                0.0,
                0.0
              ],
              "max": [
                0.0,
                0.0,
                0.0
              ]
            },
            "clip": {
              "min": [
                0.375,
                0.375,
                0.375
              ],
              "max": [
                0.625,
                0.625,
                0.625
              ]
            }
          },
          "netease:render_layer": {
            "value": "optionalAlpha"
          },
          "netease:no_crop_face_block": {},
          "netease:solid": {
            "value": false
          },
          "netease:pathable": {
            "value": true
          }
        }
      }
    ]
  }
}
