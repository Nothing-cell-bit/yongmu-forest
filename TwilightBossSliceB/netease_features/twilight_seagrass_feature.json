{
  "format_version": "1.21.40",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "tf_slice:twilight_seagrass_feature"
    },
    "places_block": [
      {
        "block": "minecraft:seagrass",
        "weight": 1
      }
    ],
    "enforce_placement_rules": false,
    "enforce_survivability_rules": false,
    "may_replace": [
      "minecraft:air",
      "minecraft:water"
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
      "bottom": [
        "minecraft:dirt",
        "minecraft:sand",
        "minecraft:gravel",
        "minecraft:clay"
      ]
    }
  }
}
