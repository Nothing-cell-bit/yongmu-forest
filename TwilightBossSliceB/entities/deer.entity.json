{
  "format_version": "1.20.60",
  "minecraft:entity": {
    "description": {
      "identifier": "tf_slice:deer",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "tf_slice:adult": {
        "minecraft:behavior.breed": {
          "priority": 2,
          "speed_multiplier": 1.0
        },
        "minecraft:breedable": {
          "require_tame": false,
          "breeds_with": {
            "mate_type": "tf_slice:deer",
            "baby_type": "tf_slice:deer",
            "breed_event": {
              "event": "minecraft:entity_born",
              "target": "baby"
            }
          },
          "breed_items": [
            "minecraft:wheat"
          ]
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/deer.json"
        }
      },
      "tf_slice:baby": {
        "minecraft:is_baby": {},
        "minecraft:scale": {
          "value": 0.5
        },
        "minecraft:ageable": {
          "duration": 1200,
          "feed_items": [
            "minecraft:wheat"
          ],
          "grow_up": {
            "event": "tf_slice:grow_up",
            "target": "self"
          }
        },
        "minecraft:behavior.follow_parent": {
          "priority": 4,
          "speed_multiplier": 1.2
        },
        "minecraft:loot": {
          "table": "loot_tables/entities/tf_slice/empty.json"
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "tf_slice_forest_animal",
          "deer",
          "animal",
          "mob"
        ]
      },
      "minecraft:nameable": {},
      "minecraft:health": {
        "value": 10,
        "max": 10
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "avoid_damage_blocks": true
      },
      "minecraft:jump.static": {},
      "minecraft:collision_box": {
        "width": 0.8,
        "height": 1.8
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/deer.json"
      },
      "minecraft:leashable": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:behavior.float": {
        "priority": 0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "speed_multiplier": 1.45
      },
      "minecraft:behavior.tempt": {
        "priority": 3,
        "speed_multiplier": 1.2,
        "items": [
          "minecraft:wheat"
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 1.0
      },
      "minecraft:behavior.look_at_player": {
        "priority": 6,
        "look_distance": 8.0,
        "probability": 0.03
      },
      "minecraft:behavior.random_look_around": {
        "priority": 7
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "tf_slice:adult"
          ]
        }
      },
      "minecraft:entity_born": {
        "remove": {
          "component_groups": [
            "tf_slice:adult"
          ]
        },
        "add": {
          "component_groups": [
            "tf_slice:baby"
          ]
        }
      },
      "tf_slice:grow_up": {
        "remove": {
          "component_groups": [
            "tf_slice:baby"
          ]
        },
        "add": {
          "component_groups": [
            "tf_slice:adult"
          ]
        }
      }
    }
  }
}
