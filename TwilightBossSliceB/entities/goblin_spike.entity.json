{
  "format_version": "1.20.60",
  "minecraft:entity": {
    "description": {
      "identifier": "tf_slice:goblin_spike",
      "is_spawnable": false,
      "is_summonable": false,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "goblin_visual"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.01,
        "height": 0.01
      },
